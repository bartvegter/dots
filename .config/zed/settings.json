{
  // Extensions
  "context_servers": {},
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "cli_default_open_behavior": "existing_window",
  "auto_install_extensions": {
    "ansible": true,
    "cargo-tom": true,
    "colored-zed-icons-theme": true,
    "csv": true,
    "dbml": true,
    "docker-compose": true,
    "dockerfile": true,
    "env": true,
    "ghostty": true,
    "git-firefly": true,
    "gitlab-ci-ls": true,
    "golangci-lint": true,
    "go-snippets": true,
    "graphql": true,
    "html": true,
    "html-snippets": true,
    "hyprlang": true,
    "ini": true,
    "java": true,
    "lua": true,
    "make": true,
    "markdown-oxide": true,
    "markdownlint": true,
    "monokai-pro-ce": true,
    "nginx": true,
    "opentofu": true,
    "plantuml": true,
    "qml": true,
    "rainbow-csv": true,
    "rust-snippets": true,
    "scss": true,
    "sql": true,
    "svelte": true,
    "svelte-snippets": true,
    "tombi": true,
    "toml": true,
    "tsgo": true,
    "typst": true,
    "xml": true,
  },

  // General
  "reveal_if_open": true,
  "session": {
    "trust_all_worktrees": true,
  },
  "restore_on_startup": "launchpad",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  // Appearance
  "theme": "Monokai Pro Ristretto",
  "icon_theme": "Colored Zed Icons Theme Dark",
  "buffer_font_family": "JetBrainsMonoNL Nerd Font Mono",
  "buffer_font_size": 14.0,
  "ui_font_size": 16.0,
  "cursor_animation": {
    "enabled": true,
  },

  // Keymap
  "base_keymap": "VSCode",
  "vim_mode": true,

  // Editor
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "which_key": {
    "enabled": true,
    "delay_ms": 500,
  },
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "vertical_scroll_margin": 15.0,
  "auto_signature_help": true,
  "show_signature_help_after_edits": true,
  "relative_line_numbers": "enabled",
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
  },
  "tab_size": 2,
  "format_on_save": "on",
  "show_whitespaces": "trailing",
  "completion_menu_item_kind": "symbol",
  "inlay_hints": {
    "enabled": true,
  },
  "code_lens": "menu",
  "middle_click_paste": false,
  "colorize_brackets": true,

  // Language & Tools
  "prettier": {
    "allowed": true,
  },

  "file_types": {
    "Ansible": [
      "**.ansible.yml",
      "**.ansible.yaml",
      "**/defaults/*.yml",
      "**/defaults/*.yaml",
      "**/meta/*.yml",
      "**/meta/*.yaml",
      "**/tasks/*.yml",
      "**/tasks/*.yaml",
      "**/handlers/*.yml",
      "**/handlers/*.yaml",
      "**/group_vars/*.yml",
      "**/group_vars/*.yaml",
      "**/playbooks/*.yaml",
      "**/playbooks/*.yml",
      "**playbook*.yaml",
      "**playbook*.yml",
    ],
  },

  "lsp": {
    "angular": {
      "initialization_options": {
        "angular_language_server_path": "~/.local/share/fnm/node-versions/v24.22.1/installation/lib/node_modules/@angular/language-server",
      },
    },
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "golangci-lint",
          "run",
          "--output.json.path",
          "stdout",
          "--show-stats=false",
          "--output.text.path=",
        ],
      },
    },
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "svelte": "html",
        },
        "experimental": {
          "classRegex": [
            "class=\"([^\"]*)\"",
            "class='([^']*)'",
            "class:\\s*([^\\s{]+)",
            "\\{\\s*class:\\s*\"([^\"]*)\"",
            "\\{\\s*class:\\s*'([^']*)'",
            "\\.className\\s*[+]?=\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttributeNS\\(.*,\\s*['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttribute\\(['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.add\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.remove\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.toggle\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.contains\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.replace\\(\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.replace\\([^,)]+,\\s*['\"]([^'\"]*)['\"]",
          ],
        },
      },
    },
    "tinymist": {
      "initialization_options": {
        // Enable background preview
        // Server will be running on 127.0.0.1:23635
        "preview": {
          "background": {
            "enabled": true,
          },
        },
      },

      "settings": {
        // Compile on save
        // This will compile a PDF for the `main.typ` file in the project root.
        "exportPdf": "onSave",
        "outputPath": "$root/$name",

        // Enable formatter
        "formatterMode": "typstyle",
      },
    },
  },

  "languages": {
    "Angular": {
      "language_servers": ["angular"],
      "prettier": {
        "allowed": false,
      },
      "tab_size": 4,
      "ensure_final_newline_on_save": false,
    },
    "Ansible": {
      "semantic_tokens": "combined",
    },
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
        "...",
      ],
    },
    "Go": {
      "language_servers": ["gopls", "golangci-lint"],
    },
    "HTML": {
      "language_servers": ["angular", "vscode-html-language-server"],
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "Lua": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": [
            "--syntax=Lua54",
            "--respect-ignores",
            "--stdin-filepath",
            "{buffer_path}",
            "-",
          ],
        },
      },
    },
    "Shell Script": {
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["--filename", "{buffer_path}", "--indent", "2"],
        },
      },
    },
    "TypeScript": {
      "language_servers": [
        "angular",
        "typescript-ls",
        "vtsls",
        "!typescript-language-server",
        "...",
      ],
      "prettier": {
        "allowed": false,
      },
      "tab_size": 4,
      "ensure_final_newline_on_save": false,
    },
  },

  // Window & Layout
  "status_bar": {
    "line_endings_button": true,
  },
  // Why the hell are these two blocks different zed??
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "errors",
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
  },

  // Panels
  "project_panel": {
    "dock": "left",
    "bold_folder_labels": true,
    "diagnostic_badges": true,
  },
  "outline_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
    "fallback_branch_name": "main",
    "show_count_badge": false,
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "diff_view_style": "split",

  // Terminal
  "terminal": {
    "font_size": 14.0,
    "copy_on_select": true,
  },

  // AI features
  "agent": {
    "dock": "right",
    "threads_sidebar": {
      "position": "right",
      "auto_open": false,
    },
    "enable_feedback": false,
    "show_turn_stats": true,
    "default_profile": "write",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "gpt-6.1-sol",
    },
    "model_parameters": [],
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
  },
}
