output "AU Optronics 0x7AA7" {
    mode 2560x1600@90.00
    position 0,0
    scale 1.33
    alias $INTERNAL
}

output "Microstep MSI MAG274QRF CA8A201200443" {
    mode 2560x1440@164.84
    position 1920,0
    scale 1
    alias $HOME_1_EXTEND
}

profile laptop {
    output $INTERNAL enable
    exec uwsm app -- $HOME/.config/hypr/scripts/move-workspaces.sh "eDP-1"
}

profile home_extend {
    output $INTERNAL enable
    output $HOME_1_OPEN enable
}

